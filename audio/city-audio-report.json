  "narration": [
    {
      "id": "n01",
      "text": "Welcome to Chaos City, where running a business gets a little crazy!",
      "start": 0.35,
      "end": 3.7840000000000003,
      "window": [
        0.35,
        6.35
      ],
      "speaker": "narrator",
      "startFrame": 21,
      "endFrame": 227
    },
    {
      "id": "s01",
      "text": "Oh no! The bookings at my salon are clashing again!",
      "start": 4.2,
      "end": 6.774,
      "window": [
        4.2,
        10.2
      ],
      "speaker": "salon",
      "startFrame": 252,
      "endFrame": 406.4
    },
    {
      "id": "n02",
      "text": "No stress! Kavolt builds your salon one smooth booking flow, so every slot is sorted.",
      "start": 7.15,
      "end": 12.039000000000001,
      "window": [
        7.15,
        13.15
      ],
      "speaker": "narrator",
      "startFrame": 429,
      "endFrame": 722.3
    },
    {
      "id": "s02",
      "text": "Amazing! Thank you!",
      "start": 12.1,
      "end": 13.144,
      "window": [
        12.1,
        18.1
      ],
      "speaker": "salon",
      "startFrame": 726,
      "endFrame": 788.6
    },
    {
      "id": "g01",
      "text": "Oh man! My gym's payments keep slipping away!",
      "start": 13.5,
      "end": 15.799,
      "window": [
        13.5,
        19.5
      ],
      "speaker": "gym",
      "startFrame": 810,
      "endFrame": 947.9
    },
    {
      "id": "n03",
      "text": "Kavolt connects Razorpay, so every payment lands, right on time.",
      "start": 16.2,
      "end": 19.829,
      "window": [
        16.2,
        22.2
      ],
      "speaker": "narrator",
      "startFrame": 972,
      "endFrame": 1189.7
    },
    {
      "id": "g02",
      "text": "Yes! Let's go!",
      "start": 19.9,
      "end": 20.749,
      "window": [
        19.9,
        25.9
      ],
      "speaker": "gym",
      "startFrame": 1194,
      "endFrame": 1244.9
    },
    {
      "id": "c01",
      "text": "Oh dear, my patients keep forgetting their appointments!",
      "start": 21.3,
      "end": 23.934,
      "window": [
        21.3,
        27.3
      ],
      "speaker": "clinic",
      "startFrame": 1278,
      "endFrame": 1436
    },
    {
      "id": "n04",
      "text": "Now WhatsApp reminders bring them right back to your door!",
      "start": 24.3,
      "end": 26.934,
      "window": [
        24.3,
        30.3
      ],
      "speaker": "narrator",
      "startFrame": 1458,
      "endFrame": 1616
    },
    {
      "id": "c02",
      "text": "Brilliant!",
      "start": 27,
      "end": 27.674,
      "window": [
        27,
        33
      ],
      "speaker": "clinic",
      "startFrame": 1620,
      "endFrame": 1660.4
    },
    {
      "id": "n05",
      "text": "That's Kavolt! Stunning websites and apps, beautifully designed, with everything your business needs.",
      "start": 28.2,
      "end": 33.439,
      "window": [
        28.2,
        34.2
      ],
      "speaker": "narrator",
      "startFrame": 1692,
      "endFrame": 2006.3
    },
    {
      "id": "n06",
      "text": "Built in just seven days, and reviewed right on your phone.",
      "start": 33.6,
      "end": 36.404,
      "window": [
        33.6,
        39.6
      ],
      "speaker": "narrator",
      "startFrame": 2016,
      "endFrame": 2184.2
    },
    {
      "id": "n07",
      "text": "Launch day! Your code and your keys, all yours.",
      "start": 36.6,
      "end": 38.959,
      "window": [
        36.6,
        42.6
      ],
      "speaker": "narrator",
      "startFrame": 2196,
      "endFrame": 2337.5
    },
    {
      "id": "n08",
      "text": "Real work. Really shipped.",
      "start": 39.3,
      "end": 40.608999999999995,
      "window": [
        39.3,
        45.3
      ],
      "speaker": "narrator",
      "startFrame": 2358,
      "endFrame": 2436.5
    },
    {
      "id": "n09",
      "text": "Ready to bring your business to the global stage?",
      "start": 41.9,
      "end": 44.054,
      "window": [
        41.9,
        47.9
      ],
      "speaker": "narrator",
      "startFrame": 2514,
      "endFrame": 2643.2
    },
    {
      "id": "n10",
      "text": "Visit kavolt dot antideploy dot com!",
      "start": 44.3,
      "end": 46.428999999999995,
      "window": [
        44.3,
        50.3
      ],
      "speaker": "narrator",
      "startFrame": 2658,
      "endFrame": 2785.7
    }
  ],
