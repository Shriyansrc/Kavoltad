{
  "name": "kavolt-kavey-20s",
  "version": "1.0.0",
  "private": true,
  "description": "Kavolt Studio 20-second vertical promotional film (Remotion production project)",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "preview": "remotion studio src/index.ts",
    "typecheck": "tsc --noEmit -p .",
    "audio:narration": "python scripts/tts/narrate.py --voice af_heart --out audio-src/narration",
    "audio:build": "node scripts/audio/build-audio.ts",
    "render:draft": "node scripts/render/render.mjs draft",
    "render:final": "node scripts/render/render.mjs final",
    "render:cover": "remotion still src/index.ts KavoltKavey20s deliverables/Kavolt_Kavey_20s_Cover_9x16.png --frame=210 && python scripts/render/cover_square.py"
  },
  "dependencies": {
    "@remotion/cli": "4.0.529",
    "@remotion/fonts": "4.0.529",
    "@remotion/paths": "4.0.529",
    "@remotion/shapes": "4.0.529",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "remotion": "4.0.529"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "@types/react": "19.1.12",
    "geist": "1.7.2",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22.18"
  }
}
